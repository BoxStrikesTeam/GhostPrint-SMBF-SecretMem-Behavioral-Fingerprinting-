#!/usr/bin/env bpftrace
/*
 * secretmem_watch.bt
 *
 * Amac: memfd_secret() + mmap() + mprotect() + mseal() cagri dizisini
 *       izleyerek "gizli, kernel'den korunmus bir bellek bolgesi
 *       olusturulup executable hale getirildi" davranis kalibini
 *       yakalamak icin HAM event uretmek.
 *
 * ONEMLI: Bu script secretmem bolgesinin ICERIGINI hicbir sekilde
 *         okumaz/okuyamaz (kernel'in kendisi de okuyamiyor - bu
 *         memfd_secret'in tasarim garantisi). Toplanan her sey
 *         zaten /proc/pid/maps ve syscall argumanlari uzerinden
 *         zaten gorunur olan METADATA'dir:
 *           - hangi flag'lerle memfd_secret() cagrildi
 *           - donen fd hangi mmap() cagrisinda kullanildi
 *           - mmap sonucu adres/uzunluk/prot
 *           - sonradan prot degisimi (ozellikle PROT_EXEC gecisi)
 *           - mseal() cagrisi ve flag'leri
 *           - bu adimlar arasi gecen sure (ns)
 *
 * Kullanim (root / CAP_BPF gerektirir):
 *   sudo bpftrace secretmem_watch.bt | python3 signature_correlator.py
 *
 * Not: mprotect/mseal korelasyonu bu POC'ta "ayni baslangic adresi"
 *      esletirmesiyle yapiliyor (basit ama pratikte cogu gercek
 *      kullanimda gecerli bir varsayim). Daha saglam bir surum icin
 *      interval-tree benzeri bir yapi (BPF_MAP_TYPE_LPM_TRIE ile
 *      adres araligi eslestirmesi) libbpf/C tarafinda yazilabilir.
 */

BEGIN
{
    printf("EVENT|START||||\n");
}

/* 1) memfd_secret() cagrisi - flags argumanini yakala */
tracepoint:syscalls:sys_enter_memfd_secret
{
    @secretmem_flags[tid] = args.flags;
    @secretmem_ts[tid] = nsecs;
}

/* memfd_secret() donus degeri - olusan fd'yi pid bazinda sakla */
tracepoint:syscalls:sys_exit_memfd_secret
/@secretmem_ts[tid] != 0/
{
    $fd = args.ret;
    if ($fd >= 0) {
        @secretmem_fd[pid, $fd] = 1;
        printf("EVENT|MEMFD_SECRET|%d|%s|%llu|flags=%d fd=%d\n",
               pid, comm, @secretmem_ts[tid], @secretmem_flags[tid], $fd);
    }
    delete(@secretmem_flags[tid]);
    delete(@secretmem_ts[tid]);
}

/* 2) mmap() - eger kullanilan fd bir secretmem fd ise isaretle */
tracepoint:syscalls:sys_enter_mmap
/@secretmem_fd[pid, args.fd]/
{
    @pending_mmap_len[tid] = args.len;
    @pending_mmap_prot[tid] = args.prot;
    @pending_mmap_ts[tid] = nsecs;
}

tracepoint:syscalls:sys_exit_mmap
/@pending_mmap_ts[tid] != 0/
{
    $addr = args.ret;
    if ($addr > 0) {
        @secretmem_region_start[pid, $addr] = 1;
        @secretmem_region_len[pid, $addr] = @pending_mmap_len[tid];
        printf("EVENT|MMAP_SECRETMEM|%d|%s|%llu|addr=0x%lx len=%d prot=%d\n",
               pid, comm, @pending_mmap_ts[tid], $addr,
               @pending_mmap_len[tid], @pending_mmap_prot[tid]);
    }
    delete(@pending_mmap_len[tid]);
    delete(@pending_mmap_prot[tid]);
    delete(@pending_mmap_ts[tid]);
}

/* 3) mprotect() - izlenen bir secretmem bolgesine PROT_EXEC (4) eklenmesi */
tracepoint:syscalls:sys_enter_mprotect
/@secretmem_region_start[pid, args.start]/
{
    $is_exec = (args.prot & 4) != 0;  /* PROT_EXEC = 0x4 */
    printf("EVENT|MPROTECT|%d|%s|%llu|addr=0x%lx len=%d prot=%d exec=%d\n",
           pid, comm, nsecs, args.start, args.len, args.prot, $is_exec);
}

/* 4) mseal() - izlenen bir secretmem bolgesinin sealed edilmesi */
tracepoint:syscalls:sys_enter_mseal
/@secretmem_region_start[pid, args.addr]/
{
    printf("EVENT|MSEAL|%d|%s|%llu|addr=0x%lx len=%d flags=%d\n",
           pid, comm, nsecs, args.addr, args.len, args.flags);
}

/*
 * 5) Genel syscall attribution (opsiyonel/deneysel):
 *    Izlenen bir secretmem bolgesinden syscall tetiklenmesini RIP
 *    uzerinden yakalamak icin architecture-specific bir kprobe
 *    (ör. kprobe:do_syscall_64 + PT_REGS_IP) gerekir; bu POC'ta
 *    tasinabilirlik icin disarida birakildi. signature_correlator.py
 *    icindeki yorumlarda nasil eklenecegi anlatiliyor.
 */

END
{
    printf("EVENT|END||||\n");
    clear(@secretmem_flags);
    clear(@secretmem_ts);
    clear(@secretmem_fd);
    clear(@pending_mmap_len);
    clear(@pending_mmap_prot);
    clear(@pending_mmap_ts);
    clear(@secretmem_region_start);
    clear(@secretmem_region_len);
}
